generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  hashedPassword String   @map("hashed_password")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  settings     Settings?
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]
  categories   Category[]
  monthlyPlans MonthlyPlan[]

  @@map("users")
}

model Settings {
  id          String @id @default(cuid())
  userId      String @unique @map("user_id")
  periodCount Int    @default(1) @map("period_count")
  periodDays  Int[]  @default([1]) @map("period_days")

  // Lembretes push
  remindersEnabled Boolean @default(false) @map("reminders_enabled")
  reminderEveHour  Int     @default(20)    @map("reminder_eve_hour")
  reminderDayHour  Int     @default(8)     @map("reminder_day_hour")
  remindExpenses   Boolean @default(true)  @map("remind_expenses")
  remindIncomes    Boolean @default(true)  @map("remind_incomes")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model PushSubscription {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  failures   Int       @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model NotificationLog {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  kind       String
  targetDate DateTime @map("target_date")
  sentAt     DateTime @default(now()) @map("sent_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetDate])
  @@map("notification_logs")
}

model Category {
  id     String @id @default(cuid())
  userId String @map("user_id")
  name   String
  color  String @default("#6366f1")
  order  Int    @default(0)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planExpenses PlanExpense[]

  @@unique([userId, name])
  @@map("categories")
}

model MonthlyPlan {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  year           Int
  month          Int
  cutDays        Int[]    @default([1]) @map("cut_days")
  initialBalance Float    @default(0) @map("initial_balance")
  status         String   @default("open")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses PlanExpense[]
  incomes  PlanIncome[]

  @@unique([userId, year, month])
  @@map("monthly_plans")
}

model PlanExpense {
  id                 String    @id @default(cuid())
  planId             String    @map("plan_id")
  period             Int
  description        String
  dueDate            DateTime? @map("due_date")
  plannedAmount      Float     @map("planned_amount")
  paidAmount         Float     @default(0) @map("paid_amount")
  averageAmount      Float?    @map("average_amount")
  isFixed    Boolean @default(true) @map("is_fixed")
  paymentMethod PaymentMethod @default(CASH) @map("payment_method")
  isAdjustment  Boolean       @default(false) @map("is_adjustment")
  categoryId String? @map("category_id")

  plan     MonthlyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  category Category?   @relation(fields: [categoryId], references: [id])

  @@map("plan_expenses")
}

enum PaymentMethod {
  CASH
  CARD
}

model PlanIncome {
  id             String    @id @default(cuid())
  planId         String    @map("plan_id")
  period         Int
  description    String
  expectedAmount Float     @map("expected_amount")
  receivedAmount Float     @default(0) @map("received_amount")
  averageAmount  Float?    @map("average_amount")
  dueDate        DateTime? @map("due_date")
  isFixed Boolean @default(true) @map("is_fixed")
  isAdjustment Boolean @default(false) @map("is_adjustment")

  plan MonthlyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_incomes")
}
